# Zola's local build output. The real build goes through Nix and lands in
# ./result, so nothing here is ever the artifact that gets deployed.
public/
result
result-*

.direnv/

# Generated by scripts/generate-content.py from skills/*/SKILL.md and
# skills/*/README.md. Committing it would create a second copy of every skill's
# prose, which is exactly what the generator exists to avoid.
content/skills/

# Copied out of skills/*/ by the generator so pages can link the raw scripts.
static/files/

# Zola 0.22 writes the class-based syntax stylesheets named in config.toml into
# static/ (not just into the output), so they are build artifacts that happen to
# land in a source directory. Regenerated on every build.
static/giallo-*.css
